.page {
  min-height: 100vh;
  background: #FAF5EE;
  padding: 12px 16px 0;
  box-sizing: border-box;
}

/* 概览：待购与已购数量 */
.summary {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 12px;
  padding: 12px 16px;
  margin-bottom: 14px;
}

.summary-block {
  flex: 1;
  text-align: center;
}

.summary-num {
  font-size: 20px;
  font-weight: 500;
  color: #C9663B;
  line-height: 26px;
}

.summary-num.muted {
  color: #7B685C;
}

.summary-label {
  font-size: 12px;
  color: #7B685C;
  margin-top: 2px;
}

.summary-split {
  width: 1px;
  height: 28px;
  background: #E7D9CB;
}

/* 与记录页操作按钮同一套 btn-small：32 高、圆角 9、13 号字，危险语义 */
.clear-btn {
  flex: 0 0 auto;
  margin-left: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 32px;
  padding: 0 14px;
  box-sizing: border-box;
  border-radius: 9px;
  background: #F6E4DF;
  color: #C94F3B;
  font-size: 13px;
}

/* 分区标题 */
.section {
  display: flex;
  align-items: center;
  padding: 4px 2px 8px;
}

.bought-section {
  margin-top: 10px;
}

.section-title {
  font-size: 13px;
  font-weight: 500;
  color: #3B2B23;
}

.section-count {
  margin-left: 6px;
  font-size: 12px;
  color: #7B685C;
}

/* 清单行 */
.row {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 12px;
  padding: 14px 16px;
  margin-bottom: 8px;
  min-height: 24px;
}

/* 已购行与待购同一底色，只靠文字弱化与删除线区分，避免整行像被禁用 */
.check {
  flex: 0 0 auto;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  border: 1.5px solid #E7D9CB;
  margin-right: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  color: #FFFFFF;
  background: #FFFFFF;
}

.check.checked {
  background: #708B57;
  border-color: #708B57;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-name {
  font-size: 15px;
  color: #3B2B23;
  line-height: 22px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row.bought .row-name {
  color: #B9A99B;
  text-decoration: line-through;
}

.row-meta {
  margin-top: 2px;
  font-size: 12px;
  color: #7B685C;
  line-height: 18px;
}

.row.bought .row-meta {
  color: #B7A699;
}

.row-source {
  margin-left: 6px;
}

.row-del {
  flex: 0 0 auto;
  margin-left: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 28px;
  padding: 0 10px;
  box-sizing: border-box;
  font-size: 12px;
  color: #C94F3B;
  background: #F6E4DF;
  border-radius: 8px;
}

/* 状态 */
.state {
  padding: 60px 0;
  text-align: center;
  font-size: 13px;
  color: #7B685C;
}

.state-text {
  margin-bottom: 14px;
}

.state-btn {
  display: inline-block;
  padding: 8px 20px;
  border-radius: 999px;
  background: #C9663B;
  color: #FFFFFF;
  font-size: 13px;
}

.empty {
  padding: 70px 24px;
  text-align: center;
}

.empty-title {
  font-size: 16px;
  font-weight: 500;
  color: #3B2B23;
  margin-bottom: 8px;
}

.empty-desc {
  font-size: 13px;
  color: #7B685C;
  line-height: 20px;
  margin-bottom: 20px;
}

.empty-btn {
  display: inline-block;
  padding: 9px 22px;
  border-radius: 999px;
  background: #F4E6D7;
  color: #7A4E2D;
  font-size: 13px;
}

.bottom-space {
  height: 96px;
}

/* 手工添加按钮 */
/* 手工添加按钮：与记录页分享按钮同尺寸、同底距、同水平居中。
   「+」用两条实心线画，不用字符，避免字体基线导致的偏移。 */
.fab {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 16px;
  margin: 0 auto;
  width: 56px;
  height: 56px;
  border-radius: 28px;
  background: #C9663B;
  box-shadow: 0 4px 14px rgba(201, 102, 59, 0.3);
  z-index: 5;
}

.fab-h,
.fab-v {
  position: absolute;
  top: 50%;
  left: 50%;
  background: #FFFFFF;
  border-radius: 2px;
}

.fab-h {
  width: 22px;
  height: 2.5px;
  margin: -1.25px 0 0 -11px;
}

.fab-v {
  width: 2.5px;
  height: 22px;
  margin: -11px 0 0 -1.25px;
}

/* 手工添加弹层 */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(59, 43, 35, 0.35);
  z-index: 10;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 11;
  background: #FFFFFF;
  border-radius: 16px 16px 0 0;
  padding: 18px 16px calc(16px + env(safe-area-inset-bottom));
}

.sheet-title {
  font-size: 16px;
  font-weight: 500;
  color: #3B2B23;
  margin-bottom: 16px;
}

.field {
  margin-bottom: 12px;
}

.field-row {
  display: flex;
  margin-bottom: 12px;
}

.field.half {
  flex: 1;
  margin-bottom: 0;
}

.field.half:first-child {
  margin-right: 10px;
}

.field-label {
  display: block;
  font-size: 12px;
  color: #7B685C;
  margin-bottom: 6px;
}

.field-input {
  height: 44px;
  padding: 0 12px;
  background: #FAF5EE;
  border: 1px solid #E7D9CB;
  border-radius: 10px;
  font-size: 14px;
  color: #3B2B23;
  box-sizing: border-box;
}

.sheet-actions {
  display: flex;
  margin-top: 18px;
}

.btn {
  flex: 1;
  height: 44px;
  line-height: 44px;
  text-align: center;
  border-radius: 12px;
  font-size: 15px;
}

.btn.ghost {
  background: #F4E6D7;
  color: #7A4E2D;
  margin-right: 10px;
}

.btn.primary {
  background: #C9663B;
  color: #FFFFFF;
}

.btn.primary.disabled {
  background: #E3B7A3;
}

/* 删除与清空的确认弹层：与记录页完成/取消同一套规格 */
.confirm-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 120;
  padding: 0 32px;
  box-sizing: border-box;
  background: rgba(59, 43, 35, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
}

.confirm-card {
  width: 100%;
  max-width: 300px;
  padding: 20px 16px 16px;
  box-sizing: border-box;
  border-radius: 16px;
  background: #FFFFFF;
}

.confirm-title {
  font-size: 16px;
  font-weight: 500;
  color: #3B2B23;
  text-align: center;
}

.confirm-body {
  margin-top: 10px;
}

.confirm-line {
  font-size: 13px;
  line-height: 1.6;
  color: #7B685C;
  text-align: center;
}

.confirm-actions {
  margin-top: 18px;
  display: flex;
}

.confirm-actions .btn.ghost {
  margin-right: 11px;
}

.btn.danger {
  background: #C94F3B;
  color: #FFFFFF;
}
