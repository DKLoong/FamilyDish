<view class="page">
  <view class="skeleton" wx:if="{{loading}}">
    <view class="sk-line"></view>
    <view class="sk-card"></view>
  </view>

  <view class="error-box" wx:elif="{{loadError}}">
    <view class="error-text">{{loadError}}</view>
    <view class="retry-btn" bindtap="retry">重新加载</view>
  </view>

  <block wx:else>
    <view class="card">
      <view class="field">
        <view class="label">菜名</view>
        <input class="input" value="{{name}}" maxlength="30" placeholder="例如：番茄炒蛋" data-field="name" bindinput="onFieldInput" />
      </view>

      <view class="field">
        <view class="label">分类</view>
        <input class="input" value="{{category}}" maxlength="20" placeholder="例如：家常菜" data-field="category" bindinput="onFieldInput" />
        <scroll-view class="chips" scroll-x wx:if="{{categories.length > 0}}">
          <view
            class="chip {{category === item ? 'active' : ''}}"
            wx:for="{{categories}}"
            wx:key="*this"
            data-cat="{{item}}"
            bindtap="pickCategory"
          >{{item}}</view>
        </scroll-view>
      </view>

      <view class="field">
        <view class="label">难度</view>
        <picker range="{{difficulties}}" value="{{difficultyIndex}}" bindchange="onDifficultyChange">
          <view class="input picker">{{difficulties[difficultyIndex]}}</view>
        </picker>
      </view>

      <view class="field">
        <view class="label">总耗时</view>
        <view class="duration-row">
          <input class="dur-input" type="number" value="{{timeMin}}" placeholder="0" data-field="timeMin" bindinput="onFieldInput" bindblur="onTimeBlur" />
          <text class="dur-unit">分</text>
          <input class="dur-input" type="number" value="{{timeSec}}" maxlength="2" placeholder="0" data-field="timeSec" bindinput="onFieldInput" bindblur="onTimeBlur" />
          <text class="dur-unit">秒</text>
        </view>
      </view>

      <view class="field last">
        <view class="label">一句话简介（选填）</view>
        <input class="input" value="{{description}}" maxlength="200" placeholder="这道菜的特点" data-field="description" bindinput="onFieldInput" />
      </view>
    </view>

    <view class="card">
      <view class="card-title">食材<text class="sub">数量留空即「适量」</text></view>

      <view class="ing-row" wx:for="{{ingredients}}" wx:key="key">
        <input class="ing-name" value="{{item.name}}" maxlength="30" placeholder="名称" data-index="{{index}}" data-field="name" bindinput="onIngredientInput" />
        <input class="ing-qty" type="digit" value="{{item.quantity}}" maxlength="8" placeholder="数量" data-index="{{index}}" data-field="quantity" bindinput="onIngredientInput" />
        <input class="ing-unit" value="{{item.unit}}" maxlength="10" placeholder="单位" data-index="{{index}}" data-field="unit" bindinput="onIngredientInput" />
        <view class="del" data-index="{{index}}" bindtap="removeIngredient">×</view>
      </view>

      <view class="add-row" bindtap="addIngredient">+ 添加食材</view>
    </view>

    <view class="card">
      <view class="card-title">步骤<text class="sub">时长选填，用于步骤计时</text></view>

      <view class="step-row" wx:for="{{steps}}" wx:key="id">
        <view class="step-no">{{index + 1}}</view>
        <view class="step-body">
          <textarea
            class="step-text"
            value="{{item.text}}"
            maxlength="300"
            auto-height
            placeholder="这一步做什么"
            data-index="{{index}}"
            data-field="text"
            bindinput="onStepInput"
          ></textarea>
          <view class="step-time">
            <input class="step-dur" type="number" value="{{item.min}}" placeholder="0" data-index="{{index}}" data-field="min" bindinput="onStepInput" bindblur="onStepDurationBlur" />
            <text class="step-unit">分</text>
            <input class="step-dur" type="number" value="{{item.sec}}" maxlength="2" placeholder="0" data-index="{{index}}" data-field="sec" bindinput="onStepInput" bindblur="onStepDurationBlur" />
            <text class="step-unit">秒</text>
            <view class="del" data-index="{{index}}" bindtap="removeStep">×</view>
          </view>
        </view>
      </view>

      <view class="add-row" bindtap="addStep">+ 添加步骤</view>
    </view>

    <view class="card">
      <view class="field last">
        <view class="label">小贴士（选填）</view>
        <textarea class="input textarea" value="{{tips}}" maxlength="300" auto-height placeholder="例如：番茄先烫一下去皮" data-field="tips" bindinput="onFieldInput"></textarea>
      </view>
    </view>

    <view class="bottom-space"></view>

    <view class="footer">
      <button class="cta" loading="{{submitting}}" disabled="{{submitting}}" bindtap="save">保存</button>
    </view>
  </block>
</view>
