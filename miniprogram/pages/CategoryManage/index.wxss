.page {
  min-height: 100vh;
  background: #FAF5EE;
  padding: 12px 16px 0;
  box-sizing: border-box;
}

.hint {
  font-size: 12px;
  color: #7B685C;
  line-height: 18px;
  padding: 0 2px 12px;
}

.row {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 12px;
  padding: 12px 14px;
  margin-bottom: 8px;
  min-height: 28px;
}

.row-index {
  flex: 0 0 auto;
  width: 22px;
  font-size: 12px;
  color: #B7A699;
}

.row-name {
  flex: 1;
  min-width: 0;
  font-size: 15px;
  color: #3B2B23;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-op {
  flex: 0 0 auto;
  width: 34px;
  height: 34px;
  line-height: 34px;
  text-align: center;
  margin-left: 4px;
  border-radius: 8px;
  background: #F4E6D7;
  color: #7A4E2D;
  font-size: 14px;
}

.row-action {
  flex: 0 0 auto;
  margin-left: 8px;
  padding: 7px 10px;
  border-radius: 8px;
  font-size: 12px;
  color: #C9663B;
}

.state {
  padding: 60px 0;
  text-align: center;
  font-size: 13px;
  color: #7B685C;
}

.state-text {
  margin-bottom: 14px;
}

.state-btn {
  display: inline-block;
  padding: 8px 20px;
  border-radius: 999px;
  background: #C9663B;
  color: #FFFFFF;
  font-size: 13px;
}

.empty {
  padding: 70px 24px;
  text-align: center;
}

.empty-title {
  font-size: 16px;
  font-weight: 500;
  color: #3B2B23;
  margin-bottom: 8px;
}

.empty-desc {
  font-size: 13px;
  color: #7B685C;
  line-height: 20px;
}

.bottom-space {
  height: 96px;
}

.fab {
  position: fixed;
  right: 16px;
  bottom: 24px;
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: #C9663B;
  color: #FFFFFF;
  font-size: 28px;
  line-height: 54px;
  text-align: center;
  box-shadow: 0 6px 16px rgba(201, 102, 59, 0.28);
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(59, 43, 35, 0.35);
  z-index: 10;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 11;
  background: #FFFFFF;
  border-radius: 16px 16px 0 0;
  padding: 18px 16px calc(16px + env(safe-area-inset-bottom));
}

.sheet-title {
  font-size: 16px;
  font-weight: 500;
  color: #3B2B23;
  margin-bottom: 14px;
}

.sheet-input {
  height: 44px;
  padding: 0 12px;
  background: #FAF5EE;
  border: 1px solid #E7D9CB;
  border-radius: 10px;
  font-size: 14px;
  color: #3B2B23;
  box-sizing: border-box;
}

.sheet-tip {
  margin-top: 8px;
  font-size: 12px;
  color: #7B685C;
}

.sheet-actions {
  display: flex;
  margin-top: 18px;
}

.btn {
  flex: 1;
  height: 44px;
  line-height: 44px;
  text-align: center;
  border-radius: 12px;
  font-size: 15px;
}

.btn.ghost {
  background: #F4E6D7;
  color: #7A4E2D;
  margin-right: 10px;
}

.btn.primary {
  background: #C9663B;
  color: #FFFFFF;
}

.btn.primary.disabled {
  background: #E3B7A3;
}
