<view class="page" style="padding-top: {{statusBarHeight + 16}}px">
  <view class="hero">
    <view class="hero-title">家肴匣</view>
    <view class="hero-sub">和家人共用一份菜单</view>
  </view>

  <view class="tabs">
    <view class="tab {{mode === 'create' ? 'active' : ''}}" data-mode="create" bindtap="switchMode">创建家庭</view>
    <view class="tab {{mode === 'join' ? 'active' : ''}}" data-mode="join" bindtap="switchMode">加入家庭</view>
  </view>

  <view class="card">
    <block wx:if="{{mode === 'create'}}">
      <view class="field">
        <view class="label">家庭名称</view>
        <input class="input" value="{{familyName}}" maxlength="12" placeholder="例如：林家" bindinput="onFamilyNameInput" />
      </view>
    </block>

    <block wx:else>
      <view class="field">
        <view class="label">邀请码</view>
        <input class="input code" value="{{inviteCode}}" maxlength="6" placeholder="6 位字母或数字" bindinput="onCodeInput" />
      </view>
      <view class="hint" wx:if="{{fromInvite}}">已从分享链接带入邀请码</view>
    </block>

    <view class="field">
      <view class="label">家庭内昵称</view>
      <input class="input" value="{{nickname}}" maxlength="20" placeholder="例如：妈妈" bindinput="onNicknameInput" />
    </view>

    <button class="primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">
      {{mode === 'create' ? '创建家庭' : '加入家庭'}}
    </button>
  </view>

  <view class="foot">创建者可邀请家人、管理菜品与成员</view>
</view>
