.page {
  min-height: 100vh;
  background: #FAF5EE;
  padding: 12px 16px 0;
  box-sizing: border-box;
}

.card {
  background: #FFFFFF;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 12px;
}

.card-title {
  font-size: 15px;
  font-weight: 500;
  color: #3B2B23;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.sub {
  font-size: 12px;
  color: #7B685C;
  font-weight: 400;
}

.field {
  margin-bottom: 14px;
}

.field.last {
  margin-bottom: 0;
}

/* 分与秒两个输入框，失焦时秒会进位到分 */
.duration-row {
  display: flex;
  align-items: center;
}

.dur-input {
  width: 88px;
  height: 44px;
  background: #FAF5EE;
  border-radius: 8px;
  padding: 0 12px;
  font-size: 15px;
  color: #3B2B23;
  box-sizing: border-box;
  text-align: center;
}

.dur-unit {
  margin: 0 10px 0 6px;
  font-size: 13px;
  color: #7B685C;
}

.label {
  font-size: 13px;
  color: #7B685C;
  margin-bottom: 8px;
}

.input {
  height: 44px;
  background: #FAF5EE;
  border-radius: 8px;
  padding: 0 12px;
  font-size: 15px;
  color: #3B2B23;
  box-sizing: border-box;
  width: 100%;
}

.input.textarea {
  height: auto;
  min-height: 80px;
  padding: 12px;
  line-height: 1.6;
  font-size: 14px;
}

.input.picker {
  line-height: 44px;
}

.chips {
  margin-top: 10px;
  white-space: nowrap;
}

.chip {
  display: inline-block;
  padding: 6px 12px;
  margin-right: 8px;
  border-radius: 999px;
  background: #FAF5EE;
  border: 1px solid #E7D9CB;
  font-size: 12px;
  color: #7A4E2D;
}

.chip.active {
  background: #C9663B;
  border-color: #C9663B;
  color: #FFFFFF;
}

.ing-row {
  display: flex;
  align-items: center;
  margin-top: 10px;
}

.ing-name,
.ing-qty,
.ing-unit {
  height: 40px;
  background: #FAF5EE;
  border-radius: 8px;
  padding: 0 10px;
  font-size: 14px;
  color: #3B2B23;
  box-sizing: border-box;
}

.ing-name {
  flex: 1;
  min-width: 0;
}

/* 数量与单位是短输入，内容居中放置，与左侧名称左对齐形成对照 */
.ing-qty {
  width: 72px;
  margin-left: 8px;
  text-align: center;
}

.ing-unit {
  width: 64px;
  margin-left: 8px;
  text-align: center;
}

.del {
  width: 28px;
  text-align: center;
  font-size: 20px;
  color: #C0AE9C;
  flex: 0 0 auto;
}

.add-row {
  margin-top: 14px;
  padding: 10px 0;
  text-align: center;
  border: 1px dashed #E7D9CB;
  border-radius: 10px;
  font-size: 13px;
  color: #C9663B;
}

.step-row {
  display: flex;
  margin-top: 14px;
}

.step-no {
  width: 22px;
  height: 22px;
  line-height: 22px;
  text-align: center;
  border-radius: 50%;
  background: #F4E6D7;
  color: #7A4E2D;
  font-size: 12px;
  flex: 0 0 auto;
  margin-right: 10px;
}

.step-body {
  flex: 1;
  min-width: 0;
}

.step-text {
  width: 100%;
  min-height: 44px;
  background: #FAF5EE;
  border-radius: 8px;
  padding: 10px 12px;
  font-size: 14px;
  color: #3B2B23;
  line-height: 1.6;
  box-sizing: border-box;
}

.step-time {
  margin-top: 8px;
  display: flex;
  align-items: center;
}

.step-dur {
  width: 56px;
  height: 36px;
  background: #FAF5EE;
  border-radius: 8px;
  padding: 0 8px;
  font-size: 14px;
  color: #3B2B23;
  box-sizing: border-box;
  text-align: center;
}

.step-unit {
  margin: 0 6px 0 4px;
  font-size: 12px;
  color: #7B685C;
}

.bottom-space {
  height: 110px;
}

/* 固定底栏必须建立独立层叠上下文，否则页面内容滚动到底部时会透过背景显示 */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  background: #FAF5EE;
  padding: 10px 16px calc(10px + env(safe-area-inset-bottom));
  box-shadow: 0 -1px 0 #E7D9CB;
}

.cta {
  width: 100%;
  height: 44px;
  line-height: 44px;
  border-radius: 12px;
  background: #C9663B;
  color: #FFFFFF;
  font-size: 15px;
  font-weight: 500;
  padding: 0;
}

.cta::after {
  border: none;
}

.skeleton {
  padding: 4px 0;
}

.sk-line {
  height: 20px;
  width: 40%;
  border-radius: 6px;
  background: #F1E8DC;
  margin-bottom: 16px;
}

.sk-card {
  height: 180px;
  border-radius: 12px;
  background: #F1E8DC;
}

.error-box {
  margin-top: 80px;
  text-align: center;
}

.error-text {
  font-size: 14px;
  color: #7B685C;
}

.retry-btn {
  display: inline-block;
  margin-top: 16px;
  padding: 8px 20px;
  border-radius: 8px;
  background: #F4E6D7;
  color: #7A4E2D;
  font-size: 14px;
}
