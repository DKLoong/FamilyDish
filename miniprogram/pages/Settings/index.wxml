<view class="page">
  <view class="skeleton" wx:if="{{loading}}">
    <view class="sk-line"></view>
    <view class="sk-card"></view>
    <view class="sk-card"></view>
  </view>

  <view class="error-box" wx:elif="{{loadError}}">
    <view class="error-text">{{loadError}}</view>
    <view class="retry-btn" bindtap="retry">重新加载</view>
  </view>

  <block wx:else>
    <view class="identity">
      <view class="family-name">{{familyName}}</view>
      <view class="identity-meta">
        <text class="chip">{{roleLabel}}</text>
        <text class="nick" bindtap="openNickname">{{myNickname}} · 修改昵称</text>
      </view>
    </view>

    <view class="card">
      <view class="card-title">邀请家人</view>
      <view class="invite-row">
        <text class="invite-code">{{inviteCode}}</text>
        <text class="copy" bindtap="copyCode">复制</text>
      </view>
      <view class="hint">{{inviteHint}}</view>
      <view class="btn-row">
        <button class="btn ghost" wx:if="{{canManage}}" bindtap="regenerate">重新生成</button>
        <button class="btn primary" open-type="share">分享给家人</button>
      </view>
    </view>

    <view class="card">
      <view class="card-title">成员<text class="count">{{memberCount}} / {{maxMembers}}</text></view>

      <view class="member" wx:for="{{members}}" wx:key="memberId">
        <view class="member-main">
          <view class="member-name">
            {{item.nickname}}<text class="me" wx:if="{{item.isSelf}}">（我）</text>
          </view>
          <view class="member-role">{{item.roleLabel}}</view>
        </view>
        <view class="member-ops">
          <view
            class="op"
            wx:if="{{item.canSetRole}}"
            data-id="{{item.memberId}}"
            data-role="{{item.nextRole}}"
            bindtap="toggleRole"
          >{{item.nextRoleLabel}}</view>
          <view
            class="op danger"
            wx:if="{{item.canRemove}}"
            data-id="{{item.memberId}}"
            bindtap="removeMember"
          >移除</view>
        </view>
      </view>

      <view class="capacity-row" wx:if="{{canManage}}" bindtap="goCategories">
        <text>分类管理</text>
        <text class="capacity-value">新增、改名与排序 ›</text>
      </view>

      <view class="capacity-row" wx:if="{{canManage}}" bindtap="openCapacity">
        <text>家庭人数上限</text>
        <text class="capacity-value">{{maxMembers}} 人 ›</text>
      </view>
    </view>

    <view class="danger-zone">
      <button class="btn danger" bindtap="leaveOrDissolve">{{isOwner ? '解散家庭' : '退出家庭'}}</button>
    </view>
  </block>

  <view class="mask" wx:if="{{showCapacity}}" bindtap="closeCapacity">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">家庭人数上限</view>
      <view class="stepper">
        <view class="step-btn" bindtap="decCapacity">-</view>
        <view class="step-value">{{tempCapacity}}</view>
        <view class="step-btn" bindtap="incCapacity">+</view>
      </view>
      <view class="sheet-hint">范围 {{memberCount}} ～ 50</view>
      <view class="btn-row">
        <button class="btn ghost" bindtap="closeCapacity">取消</button>
        <button class="btn primary" bindtap="saveCapacity">保存</button>
      </view>
    </view>
  </view>

  <view class="mask" wx:if="{{showNickname}}" bindtap="closeNickname">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">修改家庭内昵称</view>
      <input class="input" value="{{tempNickname}}" maxlength="20" bindinput="onNicknameInput" placeholder="1–20 个字符" />
      <view class="btn-row">
        <button class="btn ghost" bindtap="closeNickname">取消</button>
        <button class="btn primary" bindtap="saveNickname">保存</button>
      </view>
    </view>
  </view>
</view>
