.page {
  min-height: 100vh;
  background: #FAF5EE;
  padding: 16px;
  box-sizing: border-box;
}

.header {
  padding: 8px 4px 20px;
}

.header-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.header-left {
  flex: 1;
  min-width: 0;
}

.mine-btn {
  flex: 0 0 auto;
  margin-left: 12px;
  padding: 6px 14px;
  border-radius: 999px;
  background: #FFFFFF;
  border: 1px solid #E7D9CB;
  font-size: 13px;
  color: #7A4E2D;
}

.header-name {
  font-size: 22px;
  font-weight: 500;
  color: #3B2B23;
}

.header-meta {
  margin-top: 8px;
  display: flex;
  align-items: center;
}

.role-chip {
  font-size: 12px;
  color: #7A4E2D;
  background: #F4E6D7;
  border-radius: 999px;
  padding: 3px 10px;
}

.member-text {
  margin-left: 10px;
  font-size: 12px;
  color: #7B685C;
}

.card {
  background: #FFFFFF;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 12px;
}

.card-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-title {
  font-size: 15px;
  font-weight: 500;
  color: #3B2B23;
}

.card-desc {
  margin-top: 6px;
  font-size: 13px;
  color: #7B685C;
  line-height: 1.5;
}

.arrow {
  font-size: 20px;
  color: #B4A99E;
  padding-left: 12px;
}

.skeleton {
  padding: 8px 4px;
}

.skeleton-line {
  height: 22px;
  border-radius: 6px;
  background: #F1E8DC;
}

.skeleton-line.wide {
  width: 60%;
  margin-bottom: 20px;
}

.skeleton-card {
  height: 88px;
  border-radius: 12px;
  background: #F1E8DC;
}

.error-box {
  margin-top: 40px;
  text-align: center;
}

.error-text {
  font-size: 14px;
  color: #7B685C;
}

.retry-btn {
  display: inline-block;
  margin-top: 16px;
  padding: 8px 20px;
  border-radius: 8px;
  background: #F4E6D7;
  color: #7A4E2D;
  font-size: 14px;
}
