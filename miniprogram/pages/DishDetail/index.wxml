<view class="page">
  <view class="skeleton" wx:if="{{loading}}">
    <view class="sk-hero"></view>
    <view class="sk-line"></view>
    <view class="sk-line short"></view>
  </view>

  <view class="error-box" wx:elif="{{loadError}}">
    <view class="error-text">{{loadError}}</view>
    <view class="retry-btn" bindtap="retry">重新加载</view>
  </view>

  <block wx:else>
    <view class="hero">
      <image wx:if="{{dish.imageUrl}}" class="hero-img" src="{{dish.imageUrl}}" mode="aspectFill" />
      <view wx:else class="hero-art">{{initial}}</view>
    </view>

    <view class="head">
      <view class="title">{{dish.name}}</view>
      <view class="meta-row">
        <text class="chip" wx:if="{{dish.category}}">{{dish.category}}</text>
        <text class="chip" wx:if="{{dish.difficulty}}">{{dish.difficulty}}</text>
        <text class="chip" wx:if="{{dish.timeText}}">{{dish.timeText}}</text>
      </view>
      <view class="desc" wx:if="{{dish.description}}">{{dish.description}}</view>

      <view class="admin-row" wx:if="{{canManage}}">
        <view class="admin-btn" bindtap="editDish">编辑</view>
        <view class="admin-btn danger" bindtap="archiveDish">归档</view>
      </view>
    </view>

    <view class="card">
      <view class="card-title">
        <view>食材<text class="sub">{{preparedCount}} / {{ingredients.length}} 已准备</text></view>
        <text class="clear-link" wx:if="{{preparedCount > 0}}" bindtap="clearPrepared">一键清除</text>
      </view>

      <view
        class="ing-row {{item.prepared ? 'done' : ''}}"
        wx:for="{{ingredients}}"
        wx:key="key"
        data-index="{{index}}"
        bindtap="toggleIngredient"
      >
        <view class="check {{item.prepared ? 'on' : ''}}"></view>
        <view class="ing-name">{{item.name}}</view>
        <view class="ing-amount">{{item.display}}</view>
      </view>

      <view class="hint">勾选表示家里已有，点菜时不会加入购物清单</view>
    </view>

    <view class="card">
      <view class="card-title">步骤</view>
      <view class="step" wx:for="{{steps}}" wx:key="index">
        <view class="step-no">{{index + 1}}</view>
        <view class="step-main">
          <view class="step-text">{{item.text}}</view>
          <view
            wx:if="{{item.minutes}}"
            class="timer-btn {{timer && timer.stepIndex === index ? 'active' : ''}}"
            data-index="{{index}}"
            data-minutes="{{item.minutes}}"
            bindtap="startTimer"
          >{{timer && timer.stepIndex === index ? timer.text : item.timeText}}</view>
        </view>
      </view>
    </view>

    <view class="card" wx:if="{{dish.tips}}">
      <view class="card-title">小贴士</view>
      <view class="tips">{{dish.tips}}</view>
    </view>

    <view class="mask" wx:if="{{showOrderSheet}}" bindtap="closeOrderSheet">
      <view class="sheet" catchtap="noop">
        <view class="sheet-title">点这道菜</view>
        <view class="sheet-dish">{{dish.name}}</view>

        <view class="sheet-row">
          <view class="sheet-label">用餐日期</view>
          <picker mode="date" value="{{orderDate}}" bindchange="onDateChange">
            <view class="sheet-value">{{orderDate || '选择日期'}} ›</view>
          </picker>
        </view>

        <view class="sheet-row">
          <view class="sheet-label">餐次</view>
          <view class="meal-chips">
            <view
              class="meal-chip {{orderMeal === item ? 'active' : ''}}"
              wx:for="{{mealTypes}}"
              wx:key="*this"
              data-meal="{{item}}"
              bindtap="pickMeal"
            >{{item}}</view>
          </view>
        </view>

        <view class="sheet-row column">
          <view class="sheet-label">备注（选填）</view>
          <input class="sheet-input" value="{{orderRemark}}" maxlength="100" placeholder="例如：少辣" bindinput="onRemarkInput" />
        </view>

        <view class="sheet-hint">
          {{pendingCount > 0 ? '将为 ' + pendingCount + ' 项未准备食材加入购物清单' : '食材都已标记已准备，不会加入购物清单'}}
        </view>

        <view class="sheet-actions">
          <button
            class="btn ghost {{submitting ? 'is-pending' : ''}}"
            disabled="{{submitting}}"
            bindtap="closeOrderSheet"
          >取消</button>
          <button
            class="btn primary {{submitting ? 'is-pending' : ''}}"
            disabled="{{submitting}}"
            bindtap="submitOrder"
          >{{submitting ? '提交中…' : '确认点菜'}}</button>
        </view>
      </view>
    </view>

    <view class="bottom-space"></view>

    <view class="footer">
      <button class="cta" bindtap="orderDish">我要点这道菜</button>
    </view>
  </block>
</view>
