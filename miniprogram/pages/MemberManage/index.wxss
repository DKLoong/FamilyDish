.page {
  min-height: 100vh;
  background: #FAF5EE;
  padding: 12px 16px 40px;
  box-sizing: border-box;
}

.summary {
  padding: 4px 4px 10px;
  font-size: 12px;
  color: #7B685C;
}

/* 覆盖 app.wxss 全局 .card 的 margin: 20rpx 与绿色阴影 */
.card {
  background: #FFFFFF;
  border-radius: 12px;
  padding: 4px 16px;
  margin: 0;
  box-shadow: none;
}

.member {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 0;
  border-bottom: 1px solid #F1E8DC;
}

.member:last-child {
  border-bottom: none;
}

.member-main {
  flex: 1;
  min-width: 0;
}

.member-name {
  font-size: 15px;
  color: #3B2B23;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.me {
  font-size: 12px;
  color: #7B685C;
}

.member-role {
  margin-top: 4px;
  font-size: 12px;
  color: #7B685C;
}

.member-ops {
  display: flex;
  align-items: center;
}

/* 与菜品管理、记录页同一套 btn-small */
.op {
  flex: 0 0 auto;
  margin-left: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 32px;
  padding: 0 14px;
  box-sizing: border-box;
  border-radius: 9px;
  font-size: 13px;
  background: #F4E6D7;
  color: #7A4E2D;
}

.op.danger {
  background: #F6E4DF;
  color: #C94F3B;
}

/* 危险区：从「我的」页移来，间距与按钮规格保持不变（卡片 12 下边距 + 20 上间距） */
.danger-zone {
  margin-top: 32px;
}

.btn {
  flex: 1;
  height: 44px;
  line-height: 44px;
  border-radius: 12px;
  font-size: 15px;
  font-weight: 500;
  padding: 0;
  margin: 0;
}

.btn::after {
  border: none;
}

.btn.danger {
  background: #C94F3B;
  color: #FFFFFF;
  border: none;
}

.state {
  padding: 60px 0;
  text-align: center;
  font-size: 13px;
  color: #7B685C;
}

.state-text {
  margin-bottom: 14px;
}

.state-btn {
  display: inline-block;
  padding: 8px 20px;
  border-radius: 999px;
  background: #C9663B;
  color: #FFFFFF;
  font-size: 13px;
}
