.page {
  min-height: 100vh;
  background: #FAF5EE;
  padding-left: 16px;
  padding-right: 16px;
  padding-bottom: 32px;
  box-sizing: border-box;
}

.hero {
  padding: 24px 4px 20px;
}

.hero-title {
  font-size: 24px;
  font-weight: 500;
  color: #3B2B23;
  line-height: 1.4;
}

.hero-sub {
  margin-top: 6px;
  font-size: 13px;
  color: #7B685C;
}

.tabs {
  display: flex;
  background: #F4E6D7;
  border-radius: 12px;
  padding: 4px;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 10px 0;
  font-size: 14px;
  color: #7A4E2D;
  border-radius: 9px;
}

.tab.active {
  background: #FFFFFF;
  color: #C9663B;
  font-weight: 500;
}

.card {
  margin-top: 16px;
  background: #FFFFFF;
  border-radius: 12px;
  padding: 16px;
}

.field {
  margin-bottom: 16px;
}

.label {
  font-size: 13px;
  color: #7B685C;
  margin-bottom: 8px;
}

.input {
  height: 44px;
  background: #FAF5EE;
  border-radius: 8px;
  padding: 0 12px;
  font-size: 15px;
  color: #3B2B23;
}

.input.code {
  text-align: center;
  font-size: 18px;
  letter-spacing: 4px;
}

.hint {
  font-size: 12px;
  color: #708B57;
  margin-top: -8px;
  margin-bottom: 16px;
}

.primary {
  margin-top: 8px;
  height: 44px;
  line-height: 44px;
  border-radius: 12px;
  background: #C9663B;
  color: #FFFFFF;
  font-size: 15px;
  font-weight: 500;
  padding: 0;
}

.primary::after {
  border: none;
}

.primary[disabled] {
  opacity: 0.6;
}

.foot {
  margin-top: 24px;
  text-align: center;
  font-size: 12px;
  color: #7B685C;
}
