.page {
  min-height: 100vh;
  background: #FAF5EE;
}

.hero {
  height: 240px;
  background: #F4E6D7;
}

.hero-img {
  width: 100%;
  height: 240px;
  display: block;
}

.hero-art {
  height: 240px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64px;
  color: #C08A5E;
}

.head {
  padding: 16px 16px 4px;
}

.title {
  font-size: 22px;
  font-weight: 500;
  color: #3B2B23;
}

.meta-row {
  margin-top: 10px;
  display: flex;
  flex-wrap: wrap;
}

.chip {
  font-size: 12px;
  color: #7A4E2D;
  background: #F4E6D7;
  border-radius: 999px;
  padding: 3px 10px;
  margin-right: 8px;
  margin-bottom: 6px;
}

.desc {
  margin-top: 10px;
  font-size: 13px;
  color: #7B685C;
  line-height: 1.6;
}

.card {
  margin: 12px 16px 0;
  background: #FFFFFF;
  border-radius: 12px;
  padding: 16px;
}

.card-title {
  font-size: 15px;
  font-weight: 500;
  color: #3B2B23;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.sub {
  font-size: 12px;
  color: #7B685C;
  font-weight: 400;
}

.ing-row {
  display: flex;
  align-items: center;
  height: 44px;
  border-bottom: 1px solid #F1E8DC;
}

.ing-row:last-of-type {
  border-bottom: none;
}

.check {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  border: 1.5px solid #D8C6B4;
  margin-right: 10px;
  flex: 0 0 auto;
  box-sizing: border-box;
}

.check.on {
  background: #708B57;
  border-color: #708B57;
}

.ing-name {
  flex: 1;
  font-size: 15px;
  color: #3B2B23;
}

.ing-row.done .ing-name {
  color: #7B685C;
  text-decoration: line-through;
}

.ing-amount {
  font-size: 13px;
  color: #7B685C;
}

.hint {
  margin-top: 10px;
  font-size: 12px;
  color: #9A8A7C;
}

.step {
  display: flex;
  margin-top: 14px;
}

.step-no {
  width: 22px;
  height: 22px;
  line-height: 22px;
  text-align: center;
  border-radius: 50%;
  background: #F4E6D7;
  color: #7A4E2D;
  font-size: 12px;
  flex: 0 0 auto;
  margin-right: 10px;
}

.step-main {
  flex: 1;
}

.step-text {
  font-size: 14px;
  color: #3B2B23;
  line-height: 1.6;
}

.timer-btn {
  display: inline-block;
  margin-top: 8px;
  height: 32px;
  line-height: 32px;
  padding: 0 12px;
  border-radius: 9px;
  background: #F4E6D7;
  color: #7A4E2D;
  font-size: 12px;
}

.timer-btn.active {
  background: #C9663B;
  color: #FFFFFF;
}

.admin-row {
  margin-top: 14px;
  display: flex;
}

.admin-btn {
  padding: 6px 16px;
  border-radius: 999px;
  background: #F4E6D7;
  color: #7A4E2D;
  font-size: 13px;
  margin-right: 10px;
}

.admin-btn.danger {
  color: #C0392B;
  background: #FFFFFF;
  border: 1px solid #E7D9CB;
}

.tips {
  margin-top: 10px;
  font-size: 13px;
  color: #7B685C;
  line-height: 1.6;
}

.bottom-space {
  height: 96px;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  padding: 10px 16px calc(10px + env(safe-area-inset-bottom));
  box-shadow: 0 -1px 0 rgba(231, 217, 203, 0.8);
}

.cta {
  width: 100%;
  height: 44px;
  line-height: 44px;
  border-radius: 12px;
  background: #C9663B;
  color: #FFFFFF;
  font-size: 15px;
  font-weight: 500;
  padding: 0;
}

.cta::after {
  border: none;
}

.skeleton {
  padding: 16px;
}

.sk-hero {
  height: 200px;
  border-radius: 12px;
  background: #F1E8DC;
}

.sk-line {
  height: 18px;
  border-radius: 6px;
  background: #F1E8DC;
  margin-top: 14px;
}

.sk-line.short {
  width: 50%;
}

.error-box {
  margin-top: 80px;
  text-align: center;
}

.error-text {
  font-size: 14px;
  color: #7B685C;
}

.retry-btn {
  display: inline-block;
  margin-top: 16px;
  padding: 8px 20px;
  border-radius: 8px;
  background: #F4E6D7;
  color: #7A4E2D;
  font-size: 14px;
}
