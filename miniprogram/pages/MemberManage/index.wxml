<view class="page">
  <view class="skeleton" wx:if="{{loading}}">
    <view class="sk-card"></view>
  </view>

  <view class="state" wx:elif="{{loadError}}">
    <view class="state-text">{{loadError}}</view>
    <view class="state-btn" bindtap="retry">重新加载</view>
  </view>

  <block wx:else>
    <view class="summary">{{memberCount}} 位成员 · 上限 {{maxMembers}} 人</view>

    <view class="card">
      <view class="member" wx:for="{{members}}" wx:key="memberId">
        <view class="member-main">
          <view class="member-name">
            {{item.nickname}}<text class="me" wx:if="{{item.isSelf}}">（我）</text>
          </view>
          <view class="member-role">{{item.roleLabel}}</view>
        </view>
        <view class="member-ops">
          <view
            class="op"
            wx:if="{{item.canSetRole}}"
            data-id="{{item.memberId}}"
            data-role="{{item.nextRole}}"
            bindtap="toggleRole"
          >{{item.nextRoleLabel}}</view>
          <view
            class="op danger"
            wx:if="{{item.canRemove}}"
            data-id="{{item.memberId}}"
            bindtap="removeMember"
          >移除</view>
        </view>
      </view>
    </view>

    <view class="danger-zone">
      <button class="btn danger" bindtap="leaveOrDissolve">{{isOwner ? '解散家庭' : '退出家庭'}}</button>
    </view>
  </block>

  <confirm-modal
    visible="{{showConfirm}}"
    title="{{confirmTitle}}"
    lines="{{confirmLines}}"
    confirm-text="{{confirmText}}"
    danger="{{confirmDanger}}"
    pending="{{confirming}}"
    bind:cancel="closeConfirm"
    bind:confirm="submitConfirm"
  />
</view>
