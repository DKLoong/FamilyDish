.page {
  min-height: 100vh;
  background: #FAF5EE;
  padding: 16px 16px 40px;
  box-sizing: border-box;
}

/* 身份卡 */
.identity-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 12px;
}

.avatar {
  flex: 0 0 auto;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: #E8B48F;
  color: #FFFFFF;
  font-size: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 14px;
}

.identity-main {
  flex: 1;
  min-width: 0;
}

.identity-top {
  display: flex;
  align-items: center;
}

.nickname {
  max-width: 60%;
  font-size: 18px;
  font-weight: 500;
  color: #3B2B23;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.role-chip {
  flex: 0 0 auto;
  margin-left: 8px;
  height: 22px;
  line-height: 22px;
  padding: 0 10px;
  border-radius: 11px;
  background: #F8E8DC;
  color: #C9663B;
  font-size: 11px;
}

.identity-sub {
  margin-top: 6px;
  font-size: 12px;
  color: #7B685C;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 功能组 / 设置组 */
/* 必须显式覆盖 app.wxss 里全局 .card 的 margin: 20rpx 与绿色阴影，
   否则功能组、设置组会比身份卡左右各窄 10px */
.card {
  background: #FFFFFF;
  border-radius: 12px;
  padding: 0 16px;
  margin: 0 0 12px;
  box-shadow: none;
}

.row {
  height: 54px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid #F1E8DC;
}

.row:last-child {
  border-bottom: none;
}

.row-tap {
  opacity: 0.6;
}

/* 标签不参与收缩，右侧成组：昵称占可分配宽度并省略，箭头始终可见 */
.row-label {
  flex: 0 0 auto;
  font-size: 14px;
  color: #3B2B23;
  white-space: nowrap;
}

.row-right {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.row-value {
  min-width: 0;
  font-size: 14px;
  color: #7B685C;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-arrow {
  flex: 0 0 auto;
  margin-left: 6px;
  color: #9A8A7C;
}

/* 危险区 */
.danger-zone {
  margin-top: 20px;
}

/* 按钮 */
.btn {
  flex: 1;
  height: 44px;
  line-height: 44px;
  border-radius: 12px;
  font-size: 15px;
  font-weight: 500;
  padding: 0;
  margin: 0;
}

.btn::after {
  border: none;
}

.btn + .btn {
  margin-left: 11px;
}

.btn.primary {
  background: #C9663B;
  color: #FFFFFF;
}

.btn.ghost {
  background: #F4E6D7;
  color: #7A4E2D;
}

.btn.danger {
  background: #C94F3B;
  color: #FFFFFF;
  border: none;
}

.btn.primary.is-pending {
  background: #E2B39D;
  color: #FFFFFF;
  opacity: 1;
}

.btn.danger.is-pending {
  background: #E0A79E;
  color: #FFFFFF;
  opacity: 1;
}

.btn.ghost.is-pending {
  opacity: 0.45;
}

/* 底部抽屉 */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(59, 43, 35, 0.4);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}

.sheet {
  width: 100%;
  background: #FFFFFF;
  border-radius: 16px 16px 0 0;
  padding: 20px 16px calc(20px + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.sheet-title {
  font-size: 16px;
  font-weight: 500;
  color: #3B2B23;
  text-align: center;
}

.sheet-hint {
  text-align: center;
  font-size: 12px;
  color: #7B685C;
  margin-top: 10px;
}

.btn-row {
  margin-top: 18px;
  display: flex;
}

/* 邀请弹层 */
.invite-box {
  margin-top: 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FAF5EE;
  border-radius: 10px;
  padding: 14px 16px;
}

.invite-code {
  font-size: 22px;
  font-weight: 500;
  letter-spacing: 5px;
  color: #3B2B23;
}

.invite-copy {
  font-size: 13px;
  color: #C9663B;
  padding: 4px 6px;
}

/* 输入 */
.input {
  margin-top: 20px;
  height: 44px;
  background: #FAF5EE;
  border-radius: 8px;
  padding: 0 12px;
  font-size: 15px;
  color: #3B2B23;
  box-sizing: border-box;
}

/* 步进器 */
.stepper {
  margin: 24px auto 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.step-btn {
  width: 44px;
  height: 44px;
  line-height: 42px;
  text-align: center;
  border-radius: 10px;
  background: #F4E6D7;
  color: #7A4E2D;
  font-size: 20px;
}

.step-value {
  min-width: 72px;
  text-align: center;
  font-size: 22px;
  color: #3B2B23;
}

/* 骨架与错误 */
/* 骨架按实际区域高度铺：身份卡 80、功能组 5 行 ×54、设置组 2 行 ×54 */
.skeleton {
  padding-top: 0;
}

.sk-identity,
.sk-group-lg,
.sk-group-sm {
  border-radius: 12px;
  background: #F1E8DC;
  margin-bottom: 12px;
}

.sk-identity {
  height: 80px;
}

.sk-group-lg {
  height: 270px;
}

.sk-group-sm {
  height: 108px;
}

.error-box {
  margin-top: 60px;
  text-align: center;
}

.error-text {
  font-size: 14px;
  color: #7B685C;
}

.retry-btn {
  display: inline-block;
  margin-top: 16px;
  padding: 8px 20px;
  border-radius: 8px;
  background: #F4E6D7;
  color: #7A4E2D;
  font-size: 14px;
}
