.page {
  min-height: 100vh;
  background: #FAF5EE;
  padding: 16px 16px 40px;
  box-sizing: border-box;
}

.identity {
  padding: 8px 4px 20px;
}

.family-name {
  font-size: 22px;
  font-weight: 500;
  color: #3B2B23;
}

.identity-meta {
  margin-top: 10px;
  display: flex;
  align-items: center;
}

.chip {
  font-size: 12px;
  color: #7A4E2D;
  background: #F4E6D7;
  border-radius: 999px;
  padding: 3px 10px;
}

.nick {
  margin-left: 10px;
  font-size: 12px;
  color: #7B685C;
}

.card {
  background: #FFFFFF;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 12px;
}

.card-title {
  font-size: 15px;
  font-weight: 500;
  color: #3B2B23;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.count {
  font-size: 12px;
  color: #7B685C;
  font-weight: 400;
}

.invite-row {
  margin-top: 14px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FAF5EE;
  border-radius: 10px;
  padding: 12px 14px;
}

.invite-code {
  font-size: 20px;
  letter-spacing: 4px;
  color: #3B2B23;
}

.copy {
  font-size: 13px;
  color: #C9663B;
}

.hint {
  margin-top: 8px;
  font-size: 12px;
  color: #7B685C;
}

.btn-row {
  margin-top: 14px;
  display: flex;
}

.btn {
  flex: 1;
  height: 44px;
  line-height: 44px;
  border-radius: 12px;
  font-size: 15px;
  font-weight: 500;
  padding: 0;
  margin: 0;
}

.btn::after {
  border: none;
}

.btn + .btn {
  margin-left: 10px;
}

.btn.primary {
  background: #C9663B;
  color: #FFFFFF;
}

.btn.ghost {
  background: #F4E6D7;
  color: #7A4E2D;
}

.btn.danger {
  background: #FFFFFF;
  color: #C0392B;
  border: 1px solid #E7D9CB;
}

.member {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 0;
  border-bottom: 1px solid #F1E8DC;
}

.member:last-of-type {
  border-bottom: none;
}

.member-name {
  font-size: 15px;
  color: #3B2B23;
}

.me {
  font-size: 12px;
  color: #7B685C;
}

.member-role {
  margin-top: 4px;
  font-size: 12px;
  color: #7B685C;
}

.member-ops {
  display: flex;
  align-items: center;
}

.op {
  font-size: 13px;
  color: #C9663B;
  padding: 6px 8px;
}

.op.danger {
  color: #C0392B;
}

.capacity-row {
  margin-top: 8px;
  padding-top: 14px;
  border-top: 1px solid #F1E8DC;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 14px;
  color: #3B2B23;
}

.capacity-value {
  color: #7B685C;
  font-size: 13px;
}

.danger-zone {
  margin-top: 20px;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(59, 43, 35, 0.4);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}

.sheet {
  width: 100%;
  background: #FFFFFF;
  border-radius: 16px 16px 0 0;
  padding: 20px 16px calc(20px + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.sheet-title {
  font-size: 16px;
  font-weight: 500;
  color: #3B2B23;
  text-align: center;
}

.stepper {
  margin: 24px auto 8px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.step-btn {
  width: 44px;
  height: 44px;
  line-height: 42px;
  text-align: center;
  border-radius: 10px;
  background: #F4E6D7;
  color: #7A4E2D;
  font-size: 20px;
}

.step-value {
  min-width: 72px;
  text-align: center;
  font-size: 22px;
  color: #3B2B23;
}

.sheet-hint {
  text-align: center;
  font-size: 12px;
  color: #7B685C;
  margin-bottom: 8px;
}

.input {
  margin-top: 20px;
  height: 44px;
  background: #FAF5EE;
  border-radius: 8px;
  padding: 0 12px;
  font-size: 15px;
  color: #3B2B23;
}

.skeleton {
  padding: 8px 4px;
}

.sk-line {
  height: 22px;
  width: 50%;
  border-radius: 6px;
  background: #F1E8DC;
  margin-bottom: 20px;
}

.sk-card {
  height: 100px;
  border-radius: 12px;
  background: #F1E8DC;
  margin-bottom: 12px;
}

.error-box {
  margin-top: 60px;
  text-align: center;
}

.error-text {
  font-size: 14px;
  color: #7B685C;
}

.retry-btn {
  display: inline-block;
  margin-top: 16px;
  padding: 8px 20px;
  border-radius: 8px;
  background: #F4E6D7;
  color: #7A4E2D;
  font-size: 14px;
}
