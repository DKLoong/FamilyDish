<view class="page">
  <view class="skeleton" wx:if="{{loading}}">
    <view class="skeleton-line wide"></view>
    <view class="skeleton-card"></view>
  </view>

  <view class="error-box" wx:elif="{{loadError}}">
    <view class="error-text">{{loadError}}</view>
    <view class="retry-btn" bindtap="retry">重新加载</view>
  </view>

  <block wx:else>
    <view class="header">
      <view class="header-top">
        <view class="header-left">
          <view class="header-name">{{familyName || '我的家庭'}}</view>
          <view class="header-meta">
            <text class="role-chip">{{roleLabel}}</text>
            <text class="member-text">{{memberCount}} / {{maxMembers}} 人</text>
          </view>
        </view>
        <view class="mine-btn" bindtap="goMine">我的</view>
      </view>
    </view>

    <view class="card">
      <view class="card-title">菜品库</view>
      <view class="card-desc">共享菜品、菜谱与随机选菜将在下一步接入。</view>
    </view>

    <view class="card">
      <view class="card-title">家庭管理</view>
      <view class="card-desc">邀请家人、成员角色、人数上限将在下一步接入。</view>
    </view>
  </block>
</view>
