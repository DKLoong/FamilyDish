.page {
  min-height: 100vh;
  background: #FAF5EE;
  padding: 12px 16px 0;
  box-sizing: border-box;
}

.hint {
  font-size: 12px;
  color: #7B685C;
  line-height: 18px;
  padding: 0 2px 12px;
}

.row {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 12px;
  padding: 12px 14px;
  margin-bottom: 8px;
  min-height: 28px;
}

.row-index {
  flex: 0 0 auto;
  width: 22px;
  font-size: 12px;
  color: #B7A699;
}

.row-name {
  flex: 1;
  min-width: 0;
  font-size: 15px;
  color: #3B2B23;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-op {
  flex: 0 0 auto;
  width: 30px;
  height: 30px;
  line-height: 30px;
  text-align: center;
  margin-left: 3px;
  border-radius: 8px;
  background: #F4E6D7;
  color: #7A4E2D;
  font-size: 14px;
}

/* 与菜品管理、记录页同一套 btn-small 规格 */
.row-action {
  flex: 0 0 auto;
  margin-left: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 30px;
  padding: 0 10px;
  box-sizing: border-box;
  border-radius: 8px;
  font-size: 12px;
  background: #F4E6D7;
  color: #7A4E2D;
}

.row-action.danger {
  background: #F6E4DF;
  color: #C94F3B;
}

.state {
  padding: 60px 0;
  text-align: center;
  font-size: 13px;
  color: #7B685C;
}

.state-text {
  margin-bottom: 14px;
}

.state-btn {
  display: inline-block;
  padding: 8px 20px;
  border-radius: 999px;
  background: #C9663B;
  color: #FFFFFF;
  font-size: 13px;
}

.empty {
  padding: 70px 24px;
  text-align: center;
}

.empty-title {
  font-size: 16px;
  font-weight: 500;
  color: #3B2B23;
  margin-bottom: 8px;
}

.empty-desc {
  font-size: 13px;
  color: #7B685C;
  line-height: 20px;
}

.bottom-space {
  height: 96px;
}

/* 与记录页分享按钮同尺寸、同水平居中；非 tabBar 页需自行避让安全区 */
.fab {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(16px + env(safe-area-inset-bottom));
  margin: 0 auto;
  width: 56px;
  height: 56px;
  border-radius: 28px;
  background: #C9663B;
  box-shadow: 0 4px 14px rgba(201, 102, 59, 0.3);
  z-index: 5;
}

.fab-h,
.fab-v {
  position: absolute;
  top: 50%;
  left: 50%;
  background: #FFFFFF;
  border-radius: 2px;
}

.fab-h {
  width: 22px;
  height: 2.5px;
  margin: -1.25px 0 0 -11px;
}

.fab-v {
  width: 2.5px;
  height: 22px;
  margin: -11px 0 0 -1.25px;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(59, 43, 35, 0.35);
  z-index: 10;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 11;
  background: #FFFFFF;
  border-radius: 16px 16px 0 0;
  padding: 18px 16px calc(16px + env(safe-area-inset-bottom));
}

.sheet-title {
  font-size: 16px;
  font-weight: 500;
  color: #3B2B23;
  margin-bottom: 14px;
}

.sheet-input {
  height: 44px;
  padding: 0 12px;
  background: #FAF5EE;
  border: 1px solid #E7D9CB;
  border-radius: 10px;
  font-size: 14px;
  color: #3B2B23;
  box-sizing: border-box;
}

.sheet-tip {
  margin-top: 8px;
  font-size: 12px;
  color: #7B685C;
}

.sheet-actions {
  display: flex;
  margin-top: 18px;
}

.btn {
  flex: 1;
  height: 44px;
  line-height: 44px;
  text-align: center;
  border-radius: 12px;
  font-size: 15px;
}

.btn.ghost {
  background: #F4E6D7;
  color: #7A4E2D;
  margin-right: 10px;
}

.btn.primary {
  background: #C9663B;
  color: #FFFFFF;
}

.btn.primary.disabled {
  background: #E3B7A3;
}
