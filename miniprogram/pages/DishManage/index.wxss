.page {
  min-height: 100vh;
  background: #FAF5EE;
  padding: 12px 16px 0;
  box-sizing: border-box;
}

.tabs {
  display: flex;
  margin-bottom: 12px;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 9px 0;
  margin-right: 8px;
  border-radius: 999px;
  background: #FFFFFF;
  border: 1px solid #E7D9CB;
  font-size: 13px;
  color: #7A4E2D;
}

.tab:last-child {
  margin-right: 0;
}

.tab.on {
  background: #C9663B;
  border-color: #C9663B;
  color: #FFFFFF;
}

.tab-count {
  margin-left: 6px;
  font-size: 12px;
  opacity: 0.8;
}

.row {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 12px;
  padding: 12px 14px;
  margin-bottom: 8px;
  min-height: 28px;
}

.row-art {
  flex: 0 0 auto;
  width: 40px;
  height: 40px;
  border-radius: 10px;
  background: #F4E6D7;
  color: #C08A5E;
  font-size: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12px;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-name {
  font-size: 15px;
  color: #3B2B23;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-meta {
  margin-top: 3px;
  font-size: 12px;
  color: #7B685C;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 行内操作按钮统一取 design-spec 的 btn-small 规格（32pt / 圆角 9 / 13pt），
   底色区分语义：编辑为次按钮暖底，归档为危险，恢复为完成（与记录页一致）。 */
.row-op {
  flex: 0 0 auto;
  margin-left: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 32px;
  padding: 0 14px;
  box-sizing: border-box;
  border-radius: 9px;
  font-size: 13px;
  background: #F4E6D7;
  color: #7A4E2D;
}

.row-op.danger {
  background: #F6E4DF;
  color: #C94F3B;
}

.row-op.restore {
  background: #E9EFE2;
  color: #708B57;
}

.state {
  padding: 60px 0;
  text-align: center;
  font-size: 13px;
  color: #7B685C;
}

.state-text {
  margin-bottom: 14px;
}

.state-btn {
  display: inline-block;
  padding: 8px 20px;
  border-radius: 999px;
  background: #C9663B;
  color: #FFFFFF;
  font-size: 13px;
}

.empty {
  padding: 70px 24px;
  text-align: center;
}

.empty-title {
  font-size: 16px;
  font-weight: 500;
  color: #3B2B23;
  margin-bottom: 8px;
}

.empty-desc {
  font-size: 13px;
  color: #7B685C;
  line-height: 20px;
}

.bottom-space {
  height: 96px;
}

/* 与记录页分享按钮、购物页添加按钮同规格 */
.fab {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(16px + env(safe-area-inset-bottom));
  margin: 0 auto;
  width: 56px;
  height: 56px;
  border-radius: 28px;
  background: #C9663B;
  box-shadow: 0 4px 14px rgba(201, 102, 59, 0.3);
  z-index: 5;
}

.fab-h,
.fab-v {
  position: absolute;
  top: 50%;
  left: 50%;
  background: #FFFFFF;
  border-radius: 2px;
}

.fab-h {
  width: 22px;
  height: 2.5px;
  margin: -1.25px 0 0 -11px;
}

.fab-v {
  width: 2.5px;
  height: 22px;
  margin: -11px 0 0 -1.25px;
}
