/* 页面固定高度，顶部区不参与滚动，列表在 scroll-view 内滚动 */
.page {
  height: 100vh;
  background: #FAF5EE;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.top-area {
  flex: 0 0 auto;
  padding: 16px 16px 0;
}

/* 问候区 */
.greeting {
  padding: 0 4px;
}

.greeting-text {
  font-size: 18px;
  line-height: 26px;
  font-weight: 500;
  color: #3B2B23;
}

.family-chip {
  display: inline-block;
  margin-top: 8px;
  height: 26px;
  line-height: 26px;
  padding: 0 12px;
  border-radius: 999px;
  background: #F4E6D7;
  font-size: 12px;
  color: #7A4E2D;
}

/* 搜索 */
.search-input {
  margin-top: 14px;
  height: 44px;
  background: #FFFFFF;
  border-radius: 12px;
  padding: 0 14px;
  font-size: 14px;
  color: #3B2B23;
  box-sizing: border-box;
}

/* 分类胶囊 */
.cats {
  margin-top: 12px;
  white-space: nowrap;
}

.cat {
  display: inline-block;
  height: 32px;
  line-height: 32px;
  padding: 0 14px;
  margin-right: 8px;
  border-radius: 999px;
  background: #F4E6D7;
  color: #7A4E2D;
  font-size: 13px;
}

.cat.active {
  background: #C9663B;
  color: #FFFFFF;
}

/* 工具栏 */
.toolbar {
  margin-top: 14px;
  padding: 0 4px 10px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.toolbar-title {
  font-size: 15px;
  font-weight: 500;
  color: #3B2B23;
}

.toolbar-count {
  margin-left: 6px;
  font-size: 12px;
  font-weight: 400;
  color: #7B685C;
}

.toolbar-right {
  display: flex;
  align-items: center;
}

.random-btn {
  font-size: 13px;
  color: #C9663B;
  padding: 6px 12px;
  border-radius: 999px;
  background: #F4E6D7;
}

.manage-btn {
  margin-left: 8px;
  font-size: 13px;
  color: #7B685C;
  padding: 6px 4px;
}

/* 列表区：flex 撑满剩余高度，内部滚动 */
.list-area {
  flex: 1;
  min-height: 0;
}

.list-inner {
  padding: 0 16px 40px;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

/* 卡片：两列，图片 4:3，与标注稿 167×212 对应 */
.dish-card {
  width: calc((100% - 12px) / 2);
  background: #FFFFFF;
  border-radius: 12px;
  padding: 12px;
  box-sizing: border-box;
  margin-bottom: 12px;
}

.dish-art {
  position: relative;
  width: 100%;
  padding-top: 75%;
  border-radius: 12px;
  background: #F4E6D7;
  overflow: hidden;
}

.dish-art-text {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #C08A5E;
  font-size: 28px;
}

.dish-info {
  padding-top: 10px;
}

.dish-name {
  font-size: 15px;
  font-weight: 500;
  color: #3B2B23;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-meta {
  margin-top: 4px;
  font-size: 12px;
  color: #7B685C;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-tag {
  display: inline-block;
  margin-top: 8px;
  max-width: 100%;
  padding: 2px 8px;
  border-radius: 999px;
  background: #F4E6D7;
  font-size: 11px;
  color: #7A4E2D;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 状态 */
.skeleton {
  display: flex;
  justify-content: space-between;
}

.sk-card {
  width: calc((100% - 12px) / 2);
  height: 180px;
  border-radius: 12px;
  background: #F1E8DC;
}

.empty {
  padding: 60px 24px;
  text-align: center;
}

.empty-title {
  font-size: 15px;
  color: #3B2B23;
}

.empty-hint {
  margin-top: 8px;
  font-size: 13px;
  color: #7B685C;
  line-height: 20px;
}

.empty-btn {
  display: inline-block;
  margin-top: 16px;
  padding: 10px 22px;
  border-radius: 12px;
  background: #C9663B;
  color: #FFFFFF;
  font-size: 14px;
}

.empty-btn.ghost {
  background: #F4E6D7;
  color: #7A4E2D;
}

.error-box {
  padding: 60px 24px;
  text-align: center;
}

.error-text {
  font-size: 14px;
  color: #7B685C;
}

.retry-btn {
  display: inline-block;
  margin-top: 16px;
  padding: 8px 20px;
  border-radius: 8px;
  background: #F4E6D7;
  color: #7A4E2D;
  font-size: 14px;
}
