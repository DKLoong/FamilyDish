.page {
  min-height: 100vh;
  background: #FAF5EE;
}

.hero {
  height: 240px;
  background: #F4E6D7;
}

.hero-img {
  width: 100%;
  height: 240px;
  display: block;
}

.hero-art {
  height: 240px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64px;
  color: #C08A5E;
}

.head {
  padding: 16px 16px 4px;
}

.title {
  font-size: 22px;
  font-weight: 500;
  color: #3B2B23;
}

.meta-row {
  margin-top: 10px;
  display: flex;
  flex-wrap: wrap;
}

.chip {
  font-size: 12px;
  color: #7A4E2D;
  background: #F4E6D7;
  border-radius: 999px;
  padding: 3px 10px;
  margin-right: 8px;
  margin-bottom: 6px;
}

.desc {
  margin-top: 10px;
  font-size: 13px;
  color: #7B685C;
  line-height: 1.6;
}

.card {
  margin: 12px 16px 0;
  background: #FFFFFF;
  border-radius: 12px;
  padding: 16px;
}

.card-title {
  font-size: 15px;
  font-weight: 500;
  color: #3B2B23;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.sub {
  font-size: 12px;
  color: #7B685C;
  font-weight: 400;
}

/* 一键清除：文字 12px，用 padding + 负 margin 把触控区撑到约 42px，不撑高标题行 */
.clear-link {
  align-self: center;
  font-size: 12px;
  font-weight: 400;
  color: #C9663B;
  padding: 12px 8px;
  margin: -12px -8px -12px 0;
}

.ing-row {
  display: flex;
  align-items: center;
  height: 44px;
  border-bottom: 1px solid #F1E8DC;
}

.ing-row:last-of-type {
  border-bottom: none;
}

.check {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  border: 1.5px solid #D8C6B4;
  margin-right: 10px;
  flex: 0 0 auto;
  box-sizing: border-box;
}

.check.on {
  background: #708B57;
  border-color: #708B57;
}

.ing-name {
  flex: 1;
  font-size: 15px;
  color: #3B2B23;
}

.ing-row.done .ing-name {
  color: #7B685C;
  text-decoration: line-through;
}

.ing-amount {
  font-size: 13px;
  color: #7B685C;
}

.hint {
  margin-top: 10px;
  font-size: 12px;
  color: #9A8A7C;
}

.step {
  display: flex;
  margin-top: 14px;
}

.step-no {
  width: 22px;
  height: 22px;
  line-height: 22px;
  text-align: center;
  border-radius: 50%;
  background: #F4E6D7;
  color: #7A4E2D;
  font-size: 12px;
  flex: 0 0 auto;
  margin-right: 10px;
}

.step-main {
  flex: 1;
}

.step-text {
  font-size: 14px;
  color: #3B2B23;
  line-height: 1.6;
}

.timer-btn {
  display: inline-block;
  margin-top: 8px;
  height: 32px;
  line-height: 32px;
  padding: 0 12px;
  border-radius: 9px;
  background: #F4E6D7;
  color: #7A4E2D;
  font-size: 12px;
}

.timer-btn.active {
  background: #C9663B;
  color: #FFFFFF;
}

.admin-row {
  margin-top: 14px;
  display: flex;
}

/* 与菜品管理页同一套 btn-small 规格：32pt 高、圆角 9、13pt 字。 */
.admin-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 32px;
  padding: 0 14px;
  box-sizing: border-box;
  border-radius: 9px;
  background: #F4E6D7;
  color: #7A4E2D;
  font-size: 13px;
  margin-right: 10px;
}

.admin-btn.danger {
  background: #F6E4DF;
  color: #C94F3B;
  border: none;
  margin-right: 0;
}

.tips {
  margin-top: 10px;
  font-size: 13px;
  color: #7B685C;
  line-height: 1.6;
}

.bottom-space {
  height: 110px;
}

/* 与编辑菜谱页保持一致：不透明底栏 + 独立层叠上下文。
   点菜弹层 z-index 为 100，仍在其之上。 */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  background: #FAF5EE;
  padding: 10px 16px calc(10px + env(safe-area-inset-bottom));
  box-shadow: 0 -1px 0 #E7D9CB;
}

.cta {
  width: 100%;
  height: 44px;
  line-height: 44px;
  border-radius: 12px;
  background: #C9663B;
  color: #FFFFFF;
  font-size: 15px;
  font-weight: 500;
  padding: 0;
}

.cta::after {
  border: none;
}

.skeleton {
  padding: 16px;
}

.sk-hero {
  height: 200px;
  border-radius: 12px;
  background: #F1E8DC;
}

.sk-line {
  height: 18px;
  border-radius: 6px;
  background: #F1E8DC;
  margin-top: 14px;
}

.sk-line.short {
  width: 50%;
}


.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(59, 43, 35, 0.4);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}

.sheet {
  width: 100%;
  background: #FFFFFF;
  border-radius: 16px 16px 0 0;
  padding: 20px 16px calc(20px + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.sheet-title {
  font-size: 16px;
  font-weight: 500;
  color: #3B2B23;
  text-align: center;
}

.sheet-dish {
  margin-top: 6px;
  font-size: 13px;
  color: #7B685C;
  text-align: center;
}

.sheet-row {
  margin-top: 18px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sheet-row.column {
  display: block;
}

.sheet-label {
  font-size: 13px;
  color: #7B685C;
  flex: 0 0 auto;
}

.sheet-value {
  font-size: 14px;
  color: #3B2B23;
  padding-left: 12px;
}

.meal-chips {
  display: flex;
}

.meal-chip {
  margin-left: 8px;
  padding: 6px 14px;
  border-radius: 999px;
  background: #FAF5EE;
  border: 1px solid #E7D9CB;
  font-size: 13px;
  color: #7A4E2D;
}

.meal-chip.active {
  background: #C9663B;
  border-color: #C9663B;
  color: #FFFFFF;
}

.sheet-input {
  margin-top: 10px;
  height: 44px;
  background: #FAF5EE;
  border-radius: 8px;
  padding: 0 12px;
  font-size: 14px;
  color: #3B2B23;
}

.sheet-hint {
  margin-top: 16px;
  font-size: 12px;
  color: #9A8A7C;
  line-height: 1.5;
}

.sheet-actions {
  margin-top: 18px;
  display: flex;
}

.btn {
  flex: 1;
  height: 44px;
  line-height: 44px;
  border-radius: 12px;
  font-size: 15px;
  font-weight: 500;
  padding: 0;
  margin: 0;
}

.btn::after {
  border: none;
}

.btn + .btn {
  margin-left: 10px;
}

.btn.primary {
  background: #C9663B;
  color: #FFFFFF;
}

.btn.ghost {
  background: #F4E6D7;
  color: #7A4E2D;
}

.error-box {
  margin-top: 80px;
  text-align: center;
}

.error-text {
  font-size: 14px;
  color: #7B685C;
}

.retry-btn {
  display: inline-block;
  margin-top: 16px;
  padding: 8px 20px;
  border-radius: 8px;
  background: #F4E6D7;
  color: #7A4E2D;
  font-size: 14px;
}
