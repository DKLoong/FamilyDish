/* 与 design-spec 的弹窗规格一致：遮罩 40% 深棕、白卡圆角 16、
   双按钮高 44 间距 11，次按钮居左、确认居右 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  padding: 0 32px;
  box-sizing: border-box;
  background: rgba(59, 43, 35, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
}

.card {
  width: 100%;
  max-width: 300px;
  padding: 20px 16px 16px;
  box-sizing: border-box;
  border-radius: 16px;
  background: #FFFFFF;
}

.title {
  font-size: 16px;
  font-weight: 500;
  color: #3B2B23;
  text-align: center;
}

.body {
  margin-top: 10px;
}

.line {
  font-size: 13px;
  line-height: 1.6;
  color: #7B685C;
  text-align: center;
}

.actions {
  margin-top: 18px;
  display: flex;
}

.btn {
  flex: 1;
  height: 44px;
  line-height: 44px;
  border-radius: 12px;
  font-size: 15px;
  font-weight: 500;
  padding: 0;
  margin: 0;
}

.btn::after {
  border: none;
}

.btn + .btn {
  margin-left: 11px;
}

.btn.ghost {
  background: #F4E6D7;
  color: #7A4E2D;
}

.btn.primary {
  background: #C9663B;
  color: #FFFFFF;
}

.btn.danger {
  background: #C94F3B;
  color: #FFFFFF;
}

/* 提交中：主色与危险色退到浅档，次要按钮降透明度 */
.btn.primary.is-pending {
  background: #E2B39D;
  color: #FFFFFF;
  opacity: 1;
}

.btn.danger.is-pending {
  background: #E0A79E;
  color: #FFFFFF;
  opacity: 1;
}

.btn.ghost.is-pending {
  opacity: 0.45;
}
