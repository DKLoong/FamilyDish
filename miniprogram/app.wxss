/* FamilyDish 全局样式：只保留页面底色与按钮重置。
   卡片、表单、列表等具体样式由各页面自己定义，
   避免全局与页面级各写一半造成隐性覆盖（曾导致卡片宽度被全局 margin 撑窄、FAB 继承旧层级）。 */
page {
  background: #FAF5EE;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

button {
  background: initial;
}

button:focus {
  outline: 0;
}

button::after {
  border: none;
}
