<view class="page">
  <view class="hint">分类用于首页筛选。重命名会同步修改已使用该分类的菜品。</view>

  <view class="skeleton" wx:if="{{loading}}">
    <view class="sk-row" wx:for="{{[1,2,3,4,5]}}" wx:key="*this"></view>
  </view>

  <view class="state" wx:elif="{{loadError}}">
    <view class="state-text">{{loadError}}</view>
    <view class="state-btn" bindtap="reload">重试</view>
  </view>

  <block wx:else>
    <view class="empty" wx:if="{{categories.length === 0}}">
      <view class="empty-title">还没有分类</view>
      <view class="empty-desc">添加分类后，首页可以按分类筛选菜品</view>
    </view>

    <view class="row" wx:for="{{categories}}" wx:key="id">
      <view class="row-index">{{index + 1}}</view>
      <view class="row-name">{{item.name}}</view>
      <view class="row-op" data-index="{{index}}" data-dir="-1" catchtap="move" wx:if="{{index > 0}}">↑</view>
      <view class="row-op" data-index="{{index}}" data-dir="1" catchtap="move" wx:if="{{index < categories.length - 1}}">↓</view>
      <view class="row-action" data-id="{{item.id}}" catchtap="openRename">改名</view>
      <view class="row-action danger" data-id="{{item.id}}" catchtap="removeCategory">删除</view>
    </view>

    <view class="bottom-space"></view>
  </block>

  <view class="fab" wx:if="{{!loading && !loadError}}" bindtap="openCreate" aria-role="button" aria-label="新增分类">
    <view class="fab-h"></view>
    <view class="fab-v"></view>
  </view>

  <view class="mask" wx:if="{{showSheet}}" bindtap="closeSheet"></view>
  <view class="sheet" wx:if="{{showSheet}}" catchtap="noop">
    <view class="sheet-title">{{editingId ? '重命名分类' : '新增分类'}}</view>
    <input
      class="sheet-input"
      value="{{formName}}"
      bindinput="onNameInput"
      placeholder="如：家常菜"
      maxlength="12"
    />
    <view class="sheet-tip" wx:if="{{editingId}}">重命名会同步修改使用该分类的菜品</view>
    <view class="sheet-actions">
      <view class="btn ghost" bindtap="closeSheet">取消</view>
      <view class="btn primary {{submitting ? 'disabled' : ''}}" bindtap="submitSheet">{{submitting ? '保存中' : '保存'}}</view>
    </view>
  </view>

  <confirm-modal
    visible="{{showConfirm}}"
    title="{{confirmTitle}}"
    lines="{{confirmLines}}"
    confirm-text="{{confirmText}}"
    danger="{{confirmDanger}}"
    pending="{{confirming}}"
    bind:cancel="closeConfirm"
    bind:confirm="submitConfirm"
  />
</view>
