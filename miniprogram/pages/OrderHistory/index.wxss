.page {
  min-height: 100vh;
  background: #FAF5EE;
  padding: 12px 16px 0;
  box-sizing: border-box;
}

.filters {
  display: flex;
  margin-bottom: 12px;
}

/* 筛选胶囊按文字宽度排列，不是四等分；未选中用暖底、无边框 */
.filter {
  height: 32px;
  line-height: 32px;
  padding: 0 16px;
  margin-right: 8px;
  border-radius: 16px;
  background: #F4E6D7;
  font-size: 13px;
  color: #7A4E2D;
}

.filter:last-child {
  margin-right: 0;
}

.filter.active {
  background: #C9663B;
  color: #FFFFFF;
}

.order-card {
  background: #FFFFFF;
  border-radius: 12px;
  padding: 14px 16px;
  margin-bottom: 10px;
}

.order-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-name {
  flex: 1;
  min-width: 0;
  font-size: 16px;
  font-weight: 500;
  color: #3B2B23;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-name.muted {
  color: #7B685C;
}

.status {
  flex: 0 0 auto;
  margin-left: 10px;
  height: 24px;
  line-height: 24px;
  padding: 0 10px;
  font-size: 11px;
  border-radius: 999px;
}

.status.pending {
  background: #F8E8DC;
  color: #C9663B;
}

.status.done {
  background: #E9EFE2;
  color: #708B57;
}

.status.cancelled {
  background: #F4E6D7;
  color: #7B685C;
}

.order-meta {
  margin-top: 8px;
  font-size: 12px;
  color: #7B685C;
}

.order-remark {
  margin-top: 6px;
  font-size: 13px;
  color: #3B2B23;
  line-height: 1.5;
}

.order-bottom {
  margin-top: 10px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-time {
  font-size: 12px;
  color: #9A8A7C;
}

.order-ops {
  display: flex;
}

/* 与菜品管理页同一套 btn-small 规格：32pt 高、圆角 9、13pt 字。
   完成走绿色语义，取消走危险语义。 */
.op {
  flex: 0 0 auto;
  margin-left: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 32px;
  padding: 0 14px;
  box-sizing: border-box;
  border-radius: 9px;
  font-size: 13px;
  background: #E9EFE2;
  color: #708B57;
}

.op.danger {
  background: #F6E4DF;
  color: #C94F3B;
}

.share-space {
  height: 92px;
}

/* 微信 button 自带左右 padding 与 line-height，只给 width/height 会被撑成椭圆。
   这里用具体半径值 + 显式约束 + 关闭默认伪元素，保证是正圆。 */
.share-fab {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 16px;
  margin: 0 auto;
  width: 56px;
  min-width: 56px;
  max-width: 56px;
  height: 56px;
  min-height: 56px;
  max-height: 56px;
  padding: 0;
  border: none;
  border-radius: 28px;
  background: #C9663B;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  overflow: hidden;
  box-shadow: 0 2px 10px rgba(201, 102, 59, 0.28);
  z-index: 20;
}

.share-fab::after {
  border: none;
  display: none;
}

.share-icon {
  display: block;
  width: 24px;
  height: 24px;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(59, 43, 35, 0.4);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}

.snapshot {
  width: 100%;
  max-height: 76vh;
  background: #FFFFFF;
  border-radius: 16px 16px 0 0;
  padding: 20px 16px calc(16px + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.snapshot-title {
  font-size: 17px;
  font-weight: 500;
  color: #3B2B23;
  text-align: center;
}

.snapshot-meta {
  margin-top: 6px;
  font-size: 12px;
  color: #7B685C;
  text-align: center;
}

.snapshot-body {
  margin-top: 14px;
  flex: 1;
  max-height: 52vh;
}

.snapshot-section {
  margin-bottom: 14px;
}

.snapshot-label {
  font-size: 13px;
  font-weight: 500;
  color: #3B2B23;
  margin-bottom: 8px;
}

.snapshot-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6px 0;
  border-bottom: 1px solid #F7F1E8;
}

.snapshot-name {
  font-size: 14px;
  color: #3B2B23;
}

.snapshot-amount {
  font-size: 13px;
  color: #7B685C;
}

.snapshot-step {
  font-size: 13px;
  color: #3B2B23;
  line-height: 1.6;
  margin-bottom: 6px;
}

/* 抽屉是 flex 列容器，按钮必须显式不收缩，否则内容超高时会被压扁 */
.close-btn {
  flex: 0 0 auto;
  margin-top: 10px;
  height: 44px;
  line-height: 44px;
  border-radius: 12px;
  background: #F4E6D7;
  color: #7A4E2D;
  font-size: 15px;
  padding: 0;
}

.close-btn::after {
  border: none;
}

.skeleton {
  padding-top: 4px;
}

.sk-card {
  height: 92px;
  border-radius: 12px;
  background: #F1E8DC;
  margin-bottom: 10px;
}

.empty {
  margin-top: 72px;
  text-align: center;
}

.empty-title {
  font-size: 15px;
  color: #3B2B23;
}

.empty-hint {
  margin-top: 8px;
  font-size: 13px;
  color: #7B685C;
}

.error-box {
  margin-top: 72px;
  text-align: center;
}

.error-text {
  font-size: 14px;
  color: #7B685C;
}

.retry-btn {
  display: inline-block;
  margin-top: 16px;
  padding: 8px 20px;
  border-radius: 8px;
  background: #F4E6D7;
  color: #7A4E2D;
  font-size: 14px;
}

/* 完成与取消的确认弹层：替换 wx.showModal，视觉对齐「随机一下」弹层 */
.confirm-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  padding: 0 32px;
  box-sizing: border-box;
  background: rgba(59, 43, 35, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
}

.confirm-card {
  width: 100%;
  max-width: 300px;
  padding: 20px 16px 16px;
  box-sizing: border-box;
  border-radius: 16px;
  background: #FFFFFF;
}

.confirm-title {
  font-size: 16px;
  font-weight: 500;
  color: #3B2B23;
  text-align: center;
}

.confirm-body {
  margin-top: 10px;
}

.confirm-line {
  font-size: 13px;
  line-height: 1.6;
  color: #7B685C;
  text-align: center;
}

.confirm-actions {
  margin-top: 18px;
  display: flex;
}

.btn {
  flex: 1;
  height: 44px;
  line-height: 44px;
  border-radius: 12px;
  font-size: 15px;
  font-weight: 500;
  padding: 0;
  margin: 0;
}

.btn::after {
  border: none;
}

.btn + .btn {
  margin-left: 11px;
}

.btn.ghost {
  background: #F4E6D7;
  color: #7A4E2D;
}

.btn.primary {
  background: #C9663B;
  color: #FFFFFF;
}

.btn.danger {
  background: #C94F3B;
  color: #FFFFFF;
}

/* 处理中：主色与危险色都退到浅档，次要按钮降透明度 */
.btn.primary.is-pending {
  background: #E2B39D;
  color: #FFFFFF;
  opacity: 1;
}

.btn.danger.is-pending {
  background: #E0A79E;
  color: #FFFFFF;
  opacity: 1;
}

.btn.ghost.is-pending {
  opacity: 0.45;
}
